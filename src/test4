classdef vectorCollDetectorTest < matlab.unittest.TestCase

    methods (TestClassSetup)
        % テスト クラス全体の共有セットアップ
        function surface = createXYSurface(testcase)
            % polySurfaceセット
            vetices = [ 0   0   1;...
                        2   0   1;...
                        2   2   1;...
                        0   2   1];
            surface = polySurface(vetices);
        end

        function surface = createYZSurface(testcase)
            % polySurfaceセット
            vetices = [ 1   0   0;...
                        1   0   2;...
                        1   4   2;...
                        1   4   0];
            surface = polySurface(vetices);
        end

        function surface = createXZSurface(testcase)
            % polySurfaceセット
            vetices = [ 0   1   0;...
                        -3  1   0;...
                        -3  1   2;...
                        0   1   2];
            surface = polySurface(vetices);
        end
    end

    methods (TestMethodSetup)
        % 各テストのセットアップ
    end

    methods (Test)
        % テスト メソッド

        function detect3DNormalTest1(testcase)
            % YZ平面にて衝突①,②非衝突①,②,③が正しく判定できること
            % テスト条件
            surface = testcase.createYZSurface();
            obj = vectorCollDetector();
            rays(1,:,:) = [2 3 2;-2 3 2];
            rays(2,:,:) = [2 3 2;1 3 2];
            rays(3,:,:) = [2 6 2;0 6 2];
            rays(4,:,:) = [2 3 2;1.5 3 2];
            rays(5,:,:) = [2 3 2;2 3 4];

            % 実行結果
            [actualValue1,actualValue2] = obj.detect3D(rays,surface);

            % 期待値
            expectValue1 = [true,...
                            true,...
                            false,...
                            false,...
                            false];
            expectValue2 = {[1 3 2],...
                            [1 3 2],...
                            [],...
                            [],...
                            []};

            % テスト
            testcase.verifyEqual(actualValue1,expectValue1)
            testcase.verifyEqual(actualValue2,expectValue2,"RelTol",10^-10)
        end

        function detect3DNormalTest2(testcase)
            % XY平面にて衝突①,②非衝突①,②,③が正しく判定できること
            % テスト条件
            surface = testcase.createXYSurface();
            obj = vectorCollDetector();
            rays(1,:,:) = [1 1 2;1 1 -2];
            rays(2,:,:) = [1 1 2;1 1 1];
            rays(3,:,:) = [1 3 2;1 3 -2];
            rays(4,:,:) = [1 1 2;1 1 1.5];
            rays(5,:,:) = [1 1 4;3 1 4];

            % 実行結果
            [actualValue1,actualValue2] = obj.detect3D(rays,surface);

            % 期待値
            expectValue1 = [true,...
                            true,...
                            false,...
                            false,...
                            false];
            expectValue2 = {[1 1 1],...
                            [1 1 1],...
                            [],...
                            [],...
                            []};

            % テスト
            testcase.verifyEqual(actualValue1,expectValue1)
            testcase.verifyEqual(actualValue2,expectValue2,"RelTol",10^-10)
        end

        function detect3DNormalTest3(testcase)
            % XZ平面にて衝突①,②非衝突①,②,③が正しく判定できること
            % テスト条件
            surface = testcase.createXZSurface();
            obj = vectorCollDetector();
            rays(1,:,:) = [-2 -2 1;-2 2 1];
            rays(2,:,:) = [-2 -2 1;-2 1 1];
            rays(3,:,:) = [-2 -2 -1;-2 1 -1];
            rays(4,:,:) = [-2 2 -1;-2 1.1 -1];
            rays(5,:,:) = [-2 2 -1;4 2 -1];

            % 実行結果
            [actualValue1,actualValue2] = obj.detect3D(rays,surface);

            % 期待値
            expectValue1 = [true,...
                            true,...
                            false,...
                            false,...
                            false];
            expectValue2 = {[-2 1 1],...
                            [-2 1 1],...
                            [],...
                            [],...
                            []};

            % テスト
            testcase.verifyEqual(actualValue1,expectValue1)
            testcase.verifyEqual(actualValue2,expectValue2,"RelTol",10^-10)
        end 

        function detect1DNormalTest1(testcase)
            % detect1Dにて両方内にいる場合、片方外にいる場合、両方外にいる場合、
            % 同一直線状にいない場合が正しく判定できること
            % テスト条件
            obj = vectorCollDetector();
            rays(1,:,:) = [-1 -1;-1 -6];
            rays(2,:,:) = [-1 -1;-1 -9];
            rays(3,:,:) = [-1 5;-1 -6];
            rays(4,:,:) = [-1 5;-1 -9];
            rays(5,:,:) = [-2 5;-2 -9];
            sidePos = [-1 3;-1 -8];

            % 実行結果
            [actualValue1,actualValue2] = obj.detect1D(rays,sidePos);

            % 期待値
            expectValue1 = [false,...
                            true,...
                            true,...
                            true,...
                            false];
            expectValue2 = {[],...
                            [-1 -8],...
                            [-1 3],...
                            [-1 3;-1 -8],...
                            []};

            % テスト
            testcase.verifyEqual(actualValue1,expectValue1)
            testcase.verifyEqual(actualValue2,expectValue2,"RelTol",10^-10)
        end

        function detect2DNormalTest1(testcase)
            % YZ平面衝突③,④(detect1D含む),非衝突④,⑤が正しく判定できること
            % テスト条件
            obj = vectorCollDetector();
            rays(1,:,:) = [1 1 1;1 6 1.5];
            rays(2,:,:) = [1 -1 1;1 6 1];
            rays(3,:,:) = [1 -1 1;1 6 1.5];
            rays(4,:,:) = [1 6 2;1 -8 2];
            rays(5,:,:) = [1 5 1;1 6 1.5];
            rays(6,:,:) = [1 2 1;1 3 1.5];
            surface = testcase.createYZSurface;

            % 実行結果
            [actualValue1,actualValue2] = obj.detect2D(rays,surface);

            % 期待値
            expectValue1 = [true,...
                            true,...
                            true,...
                            true,...
                            false,...
                            false];
            expectValue2 = {[1 4 1.3],...
                            [1 0 1;1 4 1],...
                            [1 0 1.07142857143;1 4 1.35714285714],...
                            [1 0 2;1 4 2],...
                            [],...
                            []};

            % テスト
            testcase.verifyEqual(actualValue1,expectValue1)
            testcase.verifyEqual(actualValue2,expectValue2,"RelTol",10^-10)
        end

        function detectNormalTest(testcase)
            % YX平面にて3D衝突・非衝突、2D衝突・非衝突が混在する時正しく判定できること
            % テスト条件
            obj = vectorCollDetector();
            rays(1,:,:) = [2 3 2;-2 3 2];
            rays(2,:,:) = [2 6 2;0 6 2];
            rays(3,:,:) = [1 1 1;1 6 1.5];
            rays(4,:,:) = [1 5 1;1 6 1.5];
            surface = testcase.createYZSurface;

            % 実行結果
            [actualValue1,actualValue2,actualValue3] = obj.detect(rays,surface);

            % 期待値
            expectValue1 = [true,...
                            false,...
                            true,...
                            false];
            expectValue2 = {[1 3 2],...
                            [],...
                            [1 4 1.3],...
                            []};
            expectValue3 = {1,...
                            [],...
                            1,...
                            []};

            % テスト
            testcase.verifyEqual(actualValue1,expectValue1)
            testcase.verifyEqual(actualValue2,expectValue2,"RelTol",10^-10)
            testcase.verifyEqual(actualValue3,expectValue3)
        end
    end
end